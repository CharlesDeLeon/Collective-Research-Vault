# Supabase Postgres connection string.
# Supabase Dashboard -> Project -> Connect -> Session pooler (recommended)
# Replace YOUR_PROJECT_REF, YOUR_REGION, and YOUR_PASSWORD.
# If the password contains special characters, URL-encode them (e.g. @ -> %40).
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres
DB_SSL=true
DB_POOL_MAX=10

JWT_SECRET=replace-with-a-long-random-secret
PORT=5000
CLIENT_URL=http://localhost:5173

# Public URL of the frontend (used in email links)
APP_URL=http://localhost:5173

# Email transport: 'console' (default, writes to server/outbox/), 'smtp', or 'brevo'
MAIL_TRANSPORT=console
MAIL_FROM=CORE-V <noreply@core-v.local>
# SMTP (if MAIL_TRANSPORT=smtp)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# Brevo (if MAIL_TRANSPORT=brevo)
# BREVO_API_KEY=
# MAIL_FROM_EMAIL=noreply@yourdomain.com
# MAIL_FROM_NAME=CORE-V

# Local Postgres fallback (used only when DATABASE_URL is empty)
# DB_HOST=localhost
# DB_USER=postgres
# DB_PASSWORD=
# DB_NAME=core_db
# DB_PORT=5432
